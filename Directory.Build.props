<Project>
  <PropertyGroup>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>TTS Util Win contributors</Authors>
    <Product>TTS Util Win</Product>
    <Copyright>Copyright (C) 2026</Copyright>
  </PropertyGroup>

  <!-- Version name is semantic; version code is a monotonic integer, one per release. -->
  <PropertyGroup>
    <VersionPrefix>0.9.2</VersionPrefix>
    <VersionCode>15</VersionCode>
    <AssemblyVersion>0.9.2.0</AssemblyVersion>
    <FileVersion>0.9.2.$(VersionCode)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="VersionCode" Value="$(VersionCode)" />
  </ItemGroup>
</Project>
