<Window x:Class="TtsUtil.App.NameScriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Name this script" Height="170" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="What should this script be called?" Margin="0,0,0,8" />
        <TextBox x:Name="NameBox" Padding="6,4" FontSize="14" KeyDown="OnNameKeyDown" />
        <TextBlock x:Name="HintText" Foreground="#777" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Saving under a name that already exists replaces it." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SaveButton" Content="Save" IsDefault="True" Click="OnSave" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
