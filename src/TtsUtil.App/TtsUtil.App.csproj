<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TtsUtil.App</RootNamespace>
    <AssemblyName>TtsUtilWin</AssemblyName>
    <ApplicationIcon></ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TtsUtil.Core\TtsUtil.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <CoreTestProject>$(MSBuildThisFileDirectory)../../tests/TtsUtil.Core.Tests/TtsUtil.Core.Tests.csproj</CoreTestProject>
  </PropertyGroup>

  <!-- Gate the build on the Core tests. Skip with -p:SkipTests=true. -->
  <Target Name="RunCoreTestsBeforeBuild" BeforeTargets="BeforeBuild"
          Condition="'$(SkipTests)' != 'true' AND '$(DesignTimeBuild)' != 'true'">
    <Message Importance="high" Text="Running TtsUtil.Core tests before build..." />
    <Exec Command="dotnet test &quot;$(CoreTestProject)&quot; -c $(Configuration) --nologo -v q"
          IgnoreStandardErrorWarningFormat="true" />
  </Target>

</Project>
