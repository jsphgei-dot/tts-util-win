<Window x:Class="TtsUtil.App.VoiceSourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Where to find more voices" SizeToContent="Height" Width="560" MinWidth="420" MinHeight="300"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock TextWrapping="Wrap"
                       Text="The list on this tab is a small curated set. These places hold many more voices in the same format, and a link to one of their archives can be pasted into the box beside Import voice library." />

            <ItemsControl x:Name="SourceList" Margin="0,12,0,0" />

            <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,12,0,0"
                       Text="A link has to be an https link to a model archive (.tar.bz2, .tar.gz, .tar.xz, .tar, .tgz or .zip) holding the model, its tokens file and any data it needs. A bare .onnx file is not enough on its own." />
            <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,8,0,0"
                       Text="Voices carry their own licenses, which are not all as permissive as this program. Read the license in the model folder before you use a voice in anything you publish or sell." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Close" IsDefault="True" IsCancel="True" MinWidth="90" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
