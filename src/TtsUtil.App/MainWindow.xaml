<Window x:Class="TtsUtil.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TTS Util Win" Height="660" Width="940" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing">
    <DockPanel Margin="12">

        <Border DockPanel.Dock="Top" Padding="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Voice" />
                <ComboBox x:Name="VoiceBox" Grid.Row="0" Grid.Column="1" Margin="4,0,12,0" MinWidth="220"
                          VerticalAlignment="Center" SelectionChanged="OnVoiceChanged" />

                <Label Grid.Row="0" Grid.Column="2" Content="Speed" />
                <Slider x:Name="SpeedSlider" Grid.Row="0" Grid.Column="3" Minimum="0.5" Maximum="2.0" Value="1.0"
                        TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        Margin="4,0,8,0" ValueChanged="OnSpeedChanged" />
                <TextBlock x:Name="SpeedText" Grid.Row="0" Grid.Column="4" Text="1.00x" VerticalAlignment="Center"
                           Margin="0,0,12,0" MinWidth="44" />

                <Button x:Name="RescanButton" Grid.Row="0" Grid.Column="5" Content="Rescan"
                        Click="OnRescanVoices" Margin="0" />

                <StackPanel x:Name="SpeakerPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6"
                            Orientation="Horizontal" Margin="0,6,0,0">
                    <Label x:Name="SpeakerLabel" Content="Speaker" VerticalAlignment="Center" />
                    <TextBox x:Name="SpeakerSearchBox" Width="150" Margin="4,0,6,0" Padding="3,2"
                             VerticalAlignment="Center" ToolTip="Filter speakers by name or number"
                             TextChanged="OnSpeakerSearchChanged" />
                    <ComboBox x:Name="SpeakerBox" MinWidth="200" MaxDropDownHeight="360"
                              VerticalAlignment="Center" SelectionChanged="OnSpeakerChanged" />
                    <ToggleButton x:Name="FavouriteSpeakerButton" Content="Star" Width="56" Margin="6,0,0,0"
                                  VerticalAlignment="Center" ToolTip="Keep this speaker at the top of the list"
                                  Click="OnToggleFavouriteSpeaker" />
                    <Button x:Name="ShowFavouritesButton" Content="Favourites" Width="82" Margin="6,0,0,0"
                            VerticalAlignment="Center" ToolTip="Show only starred speakers"
                            Click="OnShowFavouriteSpeakers" />
                    <TextBlock x:Name="SpeakerCountText" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="#555" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="Ready." VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="Progress" Grid.Column="1" Height="14" Minimum="0" Maximum="100" />
            </Grid>
        </Border>

        <TabControl x:Name="Tabs">

            <TabItem Header="Text">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="ReadButton" Content="Read" Click="OnReadText" />
                        <Button x:Name="ReadFromHereButton" Content="Read from here" Width="110"
                                Click="OnReadFromHere"
                                ToolTip="Start at the selected line, or at the cursor when no line is selected" />
                        <Button x:Name="StopButton" Content="Stop" Click="OnStop" />
                        <Button x:Name="SaveWaveButton" Content="Save as WAV" Width="120" Click="OnSaveTextToWave" />
                        <Button x:Name="PasteButton" Content="Paste" Click="OnPasteClipboard" />
                        <Button x:Name="ClearButton" Content="Clear" Click="OnClearText" />
                        <CheckBox x:Name="ReadAsYouTypeBox" Content="Read as I type" VerticalAlignment="Center"
                                  Margin="10,0,0,0" Checked="OnReadAsYouTypeChanged" Unchecked="OnReadAsYouTypeChanged" />
                        <CheckBox x:Name="ShowLinesBox" Content="Lines" VerticalAlignment="Center" IsChecked="True"
                                  Margin="10,0,0,0" Checked="OnShowLinesChanged" Unchecked="OnShowLinesChanged" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition x:Name="LineListColumn" Width="300" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="InputText" Grid.Column="0" AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontSize="14" Padding="6" TextChanged="OnInputTextChanged" />

                        <GridSplitter x:Name="LineSplitter" Grid.Column="1" Width="6"
                                      HorizontalAlignment="Stretch" Background="Transparent" />

                        <DockPanel x:Name="LinePanel" Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Foreground="#555"
                                       Text="Double click a line to read from there." TextWrapping="Wrap" />
                            <ListBox x:Name="LineList" FontFamily="Consolas" FontSize="12"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     HorizontalContentAlignment="Stretch"
                                     MouseDoubleClick="OnLineListDoubleClick" />
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Scripts">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Foreground="#555" TextWrapping="Wrap"
                                   Text="Saved scripts are plain text files, so you can edit them outside the program too." />
                        <ListBox x:Name="ScriptList" SelectionChanged="OnScriptSelected" />
                    </DockPanel>

                    <DockPanel Grid.Column="1">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Title" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="ScriptTitleBox" Grid.Column="1" Padding="4,4"
                                     VerticalContentAlignment="Center" />
                        </Grid>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="SaveScriptButton" Content="Save from Text tab" Width="150"
                                    Click="OnSaveScript" />
                            <Button x:Name="OpenScriptButton" Content="Open in Text tab" Width="150"
                                    Click="OnOpenScript" />
                            <Button x:Name="RenameScriptButton" Content="Rename" Width="90" Click="OnRenameScript" />
                            <Button x:Name="DeleteScriptButton" Content="Delete" Width="90" Click="OnDeleteScript" />
                            <Button x:Name="ScriptFolderButton" Content="Open folder" Width="110"
                                    Click="OnOpenScriptFolder" />
                        </StackPanel>

                        <TextBlock x:Name="ScriptFolderText" DockPanel.Dock="Bottom" Foreground="#555"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />

                        <TextBox x:Name="ScriptPreview" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Padding="6" Background="#FAFAFA" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="File">
                <StackPanel Margin="10">
                    <TextBlock Text="Text file or PDF" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FilePathBox" Grid.Column="0" Padding="4,4" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Click="OnBrowseInputFile" />
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ReadFileButton" Content="Read file" Click="OnReadFile" />
                        <Button x:Name="StopFileButton" Content="Stop" Click="OnStop" />
                        <Button x:Name="ConvertFileButton" Content="Convert to WAV" Width="130" Click="OnSaveFileToWave" />
                        <Button x:Name="ImportTextButton" Content="Import to Text tab" Width="140"
                                Click="OnImportFileToTextTab" />
                    </StackPanel>
                    <TextBlock x:Name="FileInfoText" Margin="0,14,0,0" Foreground="#555" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Voices">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                               Text="Voices are downloaded from the sherpa-onnx release page and unpacked into the voices directory. The licence shown here is a summary; the authoritative text ships inside each model folder." />

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="InstallVoiceButton" Content="Install" Width="110"
                                    Click="OnInstallVoice" />
                            <Button x:Name="RemoveVoiceButton" Content="Remove" Width="110"
                                    Click="OnRemoveVoice" />
                            <Button x:Name="CancelVoiceButton" Content="Cancel" Width="110" IsEnabled="False"
                                    Click="OnCancelVoiceInstall" />
                            <Button x:Name="RescanVoicesButton" Content="Rescan" Width="110"
                                    Click="OnRescanVoices" />
                        </StackPanel>
                        <ProgressBar x:Name="VoiceProgress" Height="16" Margin="0,8,0,0" Minimum="0" Maximum="100" />
                        <TextBlock x:Name="VoiceInstallStatus" Margin="0,6,0,0" Foreground="#555"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="VoiceTargetText" Margin="0,4,0,0" Foreground="#777"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ListView x:Name="VoiceCatalogueList" SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Voice" Width="250" DisplayMemberBinding="{Binding Id}" />
                                <GridViewColumn Header="Language" Width="190" DisplayMemberBinding="{Binding Language}" />
                                <GridViewColumn Header="Size" Width="70" DisplayMemberBinding="{Binding Size}" />
                                <GridViewColumn Header="Status" Width="90" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="Licence" Width="230" DisplayMemberBinding="{Binding Licence}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Silence after line endings (ms)"
                                   Style="{StaticResource SettingLabel}" />
                        <TextBox x:Name="SilenceLineEndingBox" Grid.Row="0" Grid.Column="1"
                                 Style="{StaticResource SettingBox}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Silence after sentences (ms)"
                                   Style="{StaticResource SettingLabel}" />
                        <TextBox x:Name="SilenceSentenceBox" Grid.Row="1" Grid.Column="1"
                                 Style="{StaticResource SettingBox}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Silence after questions (ms)"
                                   Style="{StaticResource SettingLabel}" />
                        <TextBox x:Name="SilenceQuestionBox" Grid.Row="2" Grid.Column="1"
                                 Style="{StaticResource SettingBox}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Silence after exclamations (ms)"
                                   Style="{StaticResource SettingLabel}" />
                        <TextBox x:Name="SilenceExclamationBox" Grid.Row="3" Grid.Column="1"
                                 Style="{StaticResource SettingBox}" />

                        <CheckBox x:Name="ScaleSilenceBox" Grid.Row="4" Grid.Column="1"
                                  Content="Scale silence to the speech rate" Margin="0,4,0,12" />

                        <CheckBox x:Name="FilterHashBox" Grid.Row="5" Grid.Column="1"
                                  Content="Omit hash characters (#)" Margin="0,0,0,6" />
                        <CheckBox x:Name="FilterWebBox" Grid.Row="6" Grid.Column="1"
                                  Content="Omit web links" Margin="0,0,0,6" />
                        <CheckBox x:Name="FilterMailBox" Grid.Row="7" Grid.Column="1"
                                  Content="Omit mailto links" Margin="0,0,0,12" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Characters read aloud"
                                   Style="{StaticResource SettingLabel}" />
                        <ComboBox x:Name="SpokenCharactersBox" Grid.Row="8" Grid.Column="1"
                                  Margin="0,0,0,8" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="8" Grid.Column="2" Margin="8,0,0,8" Foreground="#555"
                                   VerticalAlignment="Center"
                                   Text="Punctuation still becomes a pause" />

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Also read these characters"
                                   Style="{StaticResource SettingLabel}" />
                        <TextBox x:Name="AllowedExtraBox" Grid.Row="9" Grid.Column="1"
                                 Style="{StaticResource SettingBox}"
                                 ToolTip="Characters allowed through on top of the setting above" />

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Voices directory"
                                   Style="{StaticResource SettingLabel}" />
                        <TextBox x:Name="VoicesDirBox" Grid.Row="10" Grid.Column="1"
                                 Style="{StaticResource SettingBox}" />
                        <Button Grid.Row="10" Grid.Column="2" Content="Browse" Margin="8,0,0,8"
                                Click="OnBrowseVoicesDir" />

                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Default output directory"
                                   Style="{StaticResource SettingLabel}" />
                        <TextBox x:Name="OutputDirBox" Grid.Row="11" Grid.Column="1"
                                 Style="{StaticResource SettingBox}" />
                        <Button Grid.Row="11" Grid.Column="2" Content="Browse" Margin="8,0,0,8"
                                Click="OnBrowseOutputDir" />

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Synthesis threads"
                                   Style="{StaticResource SettingLabel}" />
                        <TextBox x:Name="ThreadsBox" Grid.Row="12" Grid.Column="1"
                                 Style="{StaticResource SettingBox}" />

                        <TextBlock Grid.Row="13" Grid.Column="0" Text="Maximum characters per chunk"
                                   Style="{StaticResource SettingLabel}" />
                        <TextBox x:Name="ChunkLengthBox" Grid.Row="13" Grid.Column="1"
                                 Style="{StaticResource SettingBox}" />

                        <StackPanel Grid.Row="14" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="ApplySettingsButton" Content="Apply" Click="OnApplySettings" />
                            <TextBlock x:Name="SettingsPathText" VerticalAlignment="Center" Foreground="#555"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="TTS Util Win" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <TextBlock x:Name="VersionText" Foreground="#555" Margin="0,0,0,10" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="A Windows port of TTS Util that synthesises speech locally with sherpa-onnx. No network access and no system speech engine are required." />
                        <TextBlock x:Name="AboutVoicesText" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="This program is licensed under the Apache License 2.0, as is the original TTS Util by Dane Finlay and the sherpa-onnx library by the k2-fsa project. Each voice model carries its own licence; see the LICENSE file inside the model folder." />
                        <TextBlock x:Name="LicenseText" TextWrapping="Wrap" FontFamily="Consolas" Foreground="#444" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
