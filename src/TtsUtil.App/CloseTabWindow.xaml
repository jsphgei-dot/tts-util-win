<Window x:Class="TtsUtil.App.CloseTabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close this tab?" SizeToContent="Height" Width="420" MinWidth="320" MinHeight="170"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <TextBlock Text="Closing it throws the changes away." Foreground="#777" Margin="0,6,0,0"
                   TextWrapping="Wrap" />
        <CheckBox x:Name="StopAskingBox" Content="Don't show this again" Margin="0,14,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CloseButton" Content="Close tab" IsDefault="True" Click="OnClose" MinWidth="90" />
            <Button x:Name="KeepButton" Content="Keep it" IsCancel="True" Margin="8,0,0,0" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
